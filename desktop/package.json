{
  "name": "bot-zentrale-desktop",
  "productName": "Bot-Zentrale",
  "version": "1.0.0",
  "private": true,
  "description": "Modularer Twitch-Bot mit Dashboard",
  "author": "Pascal Schaten",
  "main": "main.js",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "de.botzentrale.desktop",
    "productName": "Bot-Zentrale",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "icon.png",
      "bundle/**/*"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "artifactName": "Bot-Zentrale-Setup-${version}.${ext}",
      "shortcutName": "Bot-Zentrale"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://DEIN-WEBSPACE.de/bot-zentrale/"
      }
    ]
  }
}
