{
  "name": "bot-zentrale",
  "version": "1.0.0",
  "private": true,
  "description": "Modularer Twitch-Bot mit Weboberfläche und Twitch-Login",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w server",
    "secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
