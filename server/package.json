    "dotenv": "^16.4.5",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
